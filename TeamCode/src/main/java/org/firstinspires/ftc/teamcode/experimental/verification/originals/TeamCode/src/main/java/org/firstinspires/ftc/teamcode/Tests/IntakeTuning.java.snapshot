package org.firstinspires.ftc.teamcode.Tests;

import com.qualcomm.robotcore.eventloop.opmode.OpMode;
import com.qualcomm.robotcore.eventloop.opmode.TeleOp;
import com.qualcomm.robotcore.hardware.DcMotor;
import com.qualcomm.robotcore.hardware.DcMotorEx;
import com.qualcomm.robotcore.hardware.Servo;
import com.qualcomm.robotcore.hardware.VoltageSensor;

import org.firstinspires.ftc.teamcode.methods.Intake;

import java.io.BufferedWriter;
import java.io.File;
import java.io.FileWriter;
import java.io.IOException;
import java.util.ArrayList;
import java.util.Locale;

/** Repeated intake power trials with selectable fixed levels and operator scores. */
@TeleOp(name = "Intake | Power Tuning", group = "Diagnostics")
public final class IntakeTuning extends OpMode {
    private static final double[] POWER_LEVELS = {.25, .35, .45, .55, .65, .75, .85, .95};

    private Intake intake;
    private final ArrayList<Trial> trials = new ArrayList<>();
    private int selectedLevel;
    private boolean running, previousLeft, previousRight;
    private double trialStarted, trialPower;
    private double speedSum, peakSpeed;
    private int speedSamples;
    private String status = "Select power, load a centered ball, then hold G1 RT to run.";
    private boolean saved;

    @Override public void init() {
        intake = new Intake(hardwareMap);
        intake.rampDowner();
        telemetry.addLine("Intake only: transfer/flywheel off; ramp down.");
        telemetry.addLine("LB/RB choose tested power | RT hold runs | A=success | B=miss/jam");
        telemetry.addLine("Repeat any level as often as needed. STOP saves CSV.");
        telemetry.update();
    }

    @Override public void loop() {
        boolean left = gamepad1.left_bumper;
        boolean right = gamepad1.right_bumper;
        if (!running && left && !previousLeft) selectedLevel = Math.max(0, selectedLevel - 1);
        if (!running && right && !previousRight) selectedLevel = Math.min(POWER_LEVELS.length - 1, selectedLevel + 1);
        previousLeft = left;
        previousRight = right;

        boolean requestRun = gamepad1.right_trigger > .1;
        if (requestRun && !running) {
            running = true;
            trialStarted = System.nanoTime() / 1e9;
            trialPower = POWER_LEVELS[selectedLevel];
            speedSum = peakSpeed = 0;
            speedSamples = 0;
            intake.setPower(trialPower);
            status = "Running selected power; release trigger to stop and score trial.";
        } else if (!requestRun && running) {
            running = false;
            intake.stop();
            status = "Trial stopped. Mark A=clean pickup or B=miss/hesitation/jam.";
        }

        intake.update();
        double speed = Math.abs(intake.getIntakeVelo());
        if (running && Double.isFinite(speed)) {
            speedSum += speed;
            speedSamples++;
            peakSpeed = Math.max(peakSpeed, speed);
        }

        if (!running && gamepad1.aWasPressed()) record(true);
        else if (!running && gamepad1.bWasPressed()) record(false);

        telemetry.addData("Selected", "%d/%d — %.0f%%", selectedLevel + 1,
                POWER_LEVELS.length, POWER_LEVELS[selectedLevel] * 100);
        telemetry.addData("Intake", running ? "RUNNING" : "STOPPED");
        telemetry.addData("Trial duration", running
                ? String.format(Locale.US, "%.2f s", System.nanoTime() / 1e9 - trialStarted) : "--");
        telemetry.addData("Intake speed", "%.0f ticks/s", speed);
        telemetry.addData("Trial mean / peak", "%.0f / %.0f ticks/s",
                speedSamples == 0 ? 0 : speedSum / speedSamples, peakSpeed);
        telemetry.addData("Battery", "%.2f V", batteryVoltage());
        telemetry.addData("Recorded results", trials.size());
        telemetry.addData("Status", status);
        telemetry.addLine("Use the same centered ball start position for comparable trials.");
        telemetry.update();
    }

    private void record(boolean success) {
        double duration = trialStarted == 0 ? 0 : System.nanoTime() / 1e9 - trialStarted;
        trials.add(new Trial(trialPower, success, duration,
                speedSamples == 0 ? 0 : speedSum / speedSamples, peakSpeed, batteryVoltage()));
        status = String.format(Locale.US, "Recorded %.0f%% as %s; repeat or select another level.",
                trialPower * 100, success ? "success" : "miss/jam");
        trialStarted = 0;
    }

    private double batteryVoltage() {
        double min = Double.POSITIVE_INFINITY;
        for (VoltageSensor sensor : hardwareMap.voltageSensor) {
            double v = sensor.getVoltage();
            if (Double.isFinite(v) && v >= 6 && v <= 16.8) min = Math.min(min, v);
        }
        return Double.isFinite(min) ? min : Double.NaN;
    }

    @Override public void stop() {
        running = false;
        if (intake != null) intake.stop();
        saveCsv();
    }

    private void saveCsv() {
        if (saved || trials.isEmpty()) return;
        saved = true;
        try {
            File base = hardwareMap.appContext.getExternalFilesDir(null);
            if (base == null) throw new IOException("External storage unavailable");
            File dir = new File(base, "flywheel-tuning");
            if (!dir.isDirectory() && !dir.mkdirs()) throw new IOException("Cannot create output folder");
            File csv = new File(dir, "intake-tuning-" + System.currentTimeMillis() + ".csv");
            try (BufferedWriter out = new BufferedWriter(new FileWriter(csv))) {
                out.write("trial,intake_power,trial_seconds,mean_ticks_s,peak_ticks_s,battery_V,outcome\n");
                for (int i = 0; i < trials.size(); i++) {
                    Trial t = trials.get(i);
                    out.write(String.format(Locale.US, "%d,%.2f,%.3f,%.1f,%.1f,%.2f,%s\n", i + 1,
                            t.power, t.duration, t.meanSpeed, t.peakSpeed, t.battery,
                            t.success ? "success" : "miss_or_hesitation_or_jam"));
                }
            }
            status = "Saved " + csv.getAbsolutePath();
        } catch (IOException ex) {
            status = "CSV save failed: " + ex.getMessage();
        }
    }

    private static final class Trial {
        final double power, duration, meanSpeed, peakSpeed, battery;
        final boolean success;
        Trial(double power, boolean success, double duration, double meanSpeed, double peakSpeed, double battery) {
            this.power = power;
            this.success = success;
            this.duration = duration;
            this.meanSpeed = meanSpeed;
            this.peakSpeed = peakSpeed;
            this.battery = battery;
        }
    }
}
