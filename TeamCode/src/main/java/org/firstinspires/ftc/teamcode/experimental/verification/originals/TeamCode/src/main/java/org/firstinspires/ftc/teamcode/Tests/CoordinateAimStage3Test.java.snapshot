package org.firstinspires.ftc.teamcode.Tests;

import com.pedropathing.follower.Follower;
import com.pedropathing.follower.ManualDrive;
import com.qualcomm.robotcore.eventloop.opmode.OpMode;
import com.qualcomm.robotcore.eventloop.opmode.TeleOp;
import com.qualcomm.robotcore.hardware.DcMotor;
import com.qualcomm.robotcore.hardware.DcMotorEx;
import com.qualcomm.robotcore.hardware.DcMotorSimple;
import com.qualcomm.robotcore.util.ElapsedTime;
import com.pedropathing.api.PoseFactory;
import org.firstinspires.ftc.teamcode.methods.CoordinateAim;
import org.firstinspires.ftc.teamcode.methods.CoordinateMotionFeedforward;
import org.firstinspires.ftc.teamcode.methods.CoordinateTurretControl;
import org.firstinspires.ftc.teamcode.pedro.Constants;

/** Stage 3 motion feedforward test; Stage 2 and competition behavior are unchanged. */
@TeleOp(name = "Coordinate Aim - Stage 3", group = "Tests")
public class CoordinateAimStage3Test extends OpMode {
    private Follower follower;
    private DcMotorEx motor;
    private boolean zeroed, fault;
    private boolean lastY, lastX, lastUp;
    private int zeroTicks;
    private String status = "Align turret forward, then START and press GP2 Y";
    private double appliedPower;
    private static final double KS = 0.04;
    private double kV = 0.001;
    private boolean feedforwardEnabled;
    private boolean lastDown;
    private final CoordinateMotionFeedforward rateEstimator = new CoordinateMotionFeedforward();
    private final ElapsedTime loopClock = new ElapsedTime();
    private double targetRate, feedbackPower, staticPower, feedforwardPower;

    @Override
    public void init() {
        motor = hardwareMap.get(DcMotorEx.class, "TurretRot");
        motor.setPower(0);
        motor.setDirection(DcMotorSimple.Direction.FORWARD);
        motor.setZeroPowerBehavior(DcMotor.ZeroPowerBehavior.BRAKE);
        motor.setMode(DcMotor.RunMode.RUN_WITHOUT_ENCODER);
        follower = Constants.create(hardwareMap);
        follower.setPose(PoseFactory.degrees().of(56, 8, 90));
        follower.manual(ManualDrive.fieldCentric(0, 0, 0, 0));
        telemetry.setMsTransmissionInterval(100);
        showTelemetry();
    }

    @Override
    public void init_loop() {
        follower.update();
        showTelemetry();
    }

    private double ticksPerDegree() { return CoordinateTurretControl.TICKS_PER_DEGREE; }
    private double angle() { return (motor.getCurrentPosition() - (double) zeroTicks) / ticksPerDegree(); }
    private double velocity() { return motor.getVelocity() / ticksPerDegree(); }

    @Override
    public void loop() {
        boolean y = gamepad2.y && !lastY;
        boolean x = gamepad2.x && !lastX;
        boolean up = gamepad2.dpad_up && !lastUp;
        boolean down = gamepad2.dpad_down && !lastDown;
        lastDown = gamepad2.dpad_down;
        lastUp = gamepad2.dpad_up;
        lastY = gamepad2.y;
        lastX = gamepad2.x;

        // After zeroing: adjust only with both A buttons released.
        if (zeroed && !fault && !gamepad2.a && !gamepad1.a && !gamepad2.y) {
            if (up != down) kV = Math.max(0, Math.min(0.010, kV + (up ? 0.00025 : -0.00025)));
            if (x) feedforwardEnabled = !feedforwardEnabled;
        }

        boolean validSensors = Double.isFinite(angle()) && Double.isFinite(velocity())
                && motor.getMode() == DcMotor.RunMode.RUN_WITHOUT_ENCODER;
        if (!validSensors) {
            fault = true;
            status = "FAULT: invalid encoder/velocity or motor mode. STOP and report";
        }

        // Capture a local reference only on an explicit, stationary operator action.
        if (y && !gamepad2.a && !gamepad2.dpad_up && !gamepad1.a) {
            motor.setPower(0);
            if (validSensors && Math.abs(velocity()) < 2) {
                zeroTicks = motor.getCurrentPosition();
                zeroed = true;
                rateEstimator.reset();
                fault = false;
                status = "Zero captured. Hold GP2 A to aim; drive with GP1 A + sticks";
            } else status = "Zero rejected: stop movement / check motor mode";
        }

        double power = 0;
        double driveScale = zeroed && !fault
                && gamepad1.a && !gamepad2.y ? 1.0 : 0;
        follower.manual(ManualDrive.fieldCentric(
                gamepad1.left_stick_y * driveScale, gamepad1.left_stick_x * driveScale,
                -gamepad1.right_stick_x * driveScale, follower.pose().heading() - Math.PI));
        follower.update();

        CoordinateAim.Result aim = aim();
        CoordinateTurretControl.Result control = CoordinateTurretControl.calculate(
                aim.relativeBearingDeg, angle(), 1, KS);
        boolean aimActive = zeroed && !fault
                && gamepad2.a && !gamepad2.y && aim.valid && control.reachable;
        feedbackPower = staticPower = feedforwardPower = targetRate = 0;
        if (aimActive) {
            targetRate = rateEstimator.update(control.targetDeg, loopClock.seconds());
            CoordinateMotionFeedforward.Command command = CoordinateMotionFeedforward.calculate(
                    control, angle(), targetRate, feedforwardEnabled ? kV : 0, KS);
            feedbackPower = command.feedbackPower;
            staticPower = command.staticPower;
            feedforwardPower = command.feedforwardPower;
            power = CoordinateTurretControl.motorPower(angle(), command.power, -1);
            status = feedforwardEnabled ? "COORDINATE AIM + MOTION FF" : "COORDINATE AIM: FF OFF";
        } else {
            rateEstimator.reset();
            if (zeroed && !fault) {
                if (!gamepad2.a || gamepad2.y) status = "Ready: hold GAMEPAD 2 A to aim";
                else if (!aim.valid) status = "STOPPED: invalid pose / at target";
                else status = "STOPPED: target outside +/-170 deg";
            }
        }
        appliedPower = zeroed && !fault
                ? Math.max(-CoordinateTurretControl.MAX_POWER,
                        Math.min(CoordinateTurretControl.MAX_POWER, power)) : 0;
        motor.setPower(appliedPower);
        showTelemetry();
    }

    private CoordinateAim.Result aim() {
        return CoordinateAim.calculate(follower.pose().x(), follower.pose().y(),
                follower.pose().heading(), 57.4, 82.3);
    }

    private void showTelemetry() {
        CoordinateAim.Result aim = aim();
        CoordinateTurretControl.Result control = CoordinateTurretControl.calculate(
                aim.relativeBearingDeg, angle(), 1, KS);
        telemetry.addData("Status", status);
        telemetry.addLine("Start pose (56,8,90deg); target (57.4,82.3)");
        telemetry.addLine("GP2 Y: confirm physically FORWARD zero (stationary)");
        telemetry.addLine("Direction mapping is preconfigured; no jog required");
        telemetry.addLine("GAMEPAD 2 A: hold to aim. GAMEPAD 1 A + sticks: drive scale 1.0");
        telemetry.addLine("GAMEPAD 2 X toggles FF; D-pad UP/DOWN adjusts kV");
        telemetry.addLine("Release A on BOTH gamepads before changing FF settings");
        telemetry.addData("Feedforward enabled", feedforwardEnabled);
        telemetry.addData("kV power/(deg/s) / kS", "%.5f / %.2f", kV, KS);
        telemetry.addData("Target rate (encoder deg/s)", "%.2f", targetRate);
        telemetry.addData("P / kS / FF (encoder-directed power)", "%.4f / %.4f / %.4f",
                feedbackPower, staticPower, feedforwardPower);
        telemetry.addData("Zero / direction", "%s / preconfigured", zeroed);
        telemetry.addData("Fault", fault);
        telemetry.addData("Encoder direction for +motor power", -1);
        telemetry.addData("Robot X/Y/heading", "%.2f / %.2f / %.2f", follower.pose().x(),
                follower.pose().y(), Math.toDegrees(follower.pose().heading()));
        telemetry.addData("Turret offset in (+X forward, +Y left)", "%.2f / %.2f",
                CoordinateAim.TURRET_OFFSET_X_INCHES, CoordinateAim.TURRET_OFFSET_Y_INCHES);
        telemetry.addData("Field / relative bearing deg", "%.2f / %.2f", aim.fieldBearingDeg, aim.relativeBearingDeg);
        telemetry.addData("Turret angle deg (local zero)", zeroed ? angle() : Double.NaN);
        telemetry.addData("Measured encoder ticks/degree", ticksPerDegree());
        telemetry.addData("Target / error deg", "%.2f / %.2f", control.targetDeg, control.errorDeg);
        telemetry.addData("Reachable", control.reachable);
        telemetry.addData("GP2 A held / Y held", "%s / %s", gamepad2.a, gamepad2.y);
        telemetry.addData("Base position error deg", control.errorDeg);
        telemetry.addData("Turret speed deg/s / power", "%.2f / %.3f", velocity(), appliedPower);
        telemetry.addData("Turret max power", CoordinateTurretControl.MAX_POWER);
        telemetry.addLine("Test bounds +/-170deg; release GP2 A to stop aiming");
        telemetry.update();
    }

    @Override
    public void stop() {
        if (motor != null) motor.setPower(0);
        if (follower != null) {
            follower.manual(ManualDrive.fieldCentric(0, 0, 0, 0));
            follower.update();
        }
    }
}
